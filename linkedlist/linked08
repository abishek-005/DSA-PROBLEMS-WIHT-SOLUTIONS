# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def rotateRight(self, head: Optional[ListNode], k: int) -> Optional[ListNode]:
        if not head or not head.next or k == 0:
            return head
        count = 1
        cur = head
        while cur.next:
            count += 1
            cur = cur.next
        k = k % count
        if k == 0:
            return head
        cur.next = head
        tar = count - k
        curr = head
        for _ in range(tar - 1): 
            curr = curr.next
        new_head = curr.next
        curr.next = None  # The cut!
        return new_head
