class Solution:
    def partition(self, head: Optional[ListNode], x: int) -> Optional[ListNode]:
        dumm1=ListNode(0)
        dumm2=ListNode(0)
        curr=head
        curr1=dumm1
        curr2=dumm2
        while curr:
            if curr.val < x:
                curr1.next=curr
                curr1=curr1.next
            else:
                curr2.next=curr
                curr2=curr2.next
            curr=curr.next
        curr2.next=None
        curr1.next=dumm2.next
        return dumm1.next
        
